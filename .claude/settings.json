{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo build-sbf:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo generate-lockfile:*)",
      "Bash(cargo nextest:*)",
      "Bash(rustup show:*)",
      "Bash(rustup toolchain list:*)",
      "Bash(rustc --version)",
      "Bash(wasm-pack build:*)",
      "Bash(wasm-pack test:*)",
      "Bash(anchor build:*)",
      "Bash(anchor test:*)",
      "Bash(anchor idl:*)",
      "Bash(anchor keys list:*)",
      "Bash(anchor --version)",
      "Bash(avm list:*)",
      "Bash(avm --version)",
      "Bash(solana-test-validator:*)",
      "Bash(solana config get)",
      "Bash(solana --version)",
      "Bash(solana cluster-version:*)",
      "Bash(solana address:*)",
      "Bash(solana balance:*)",
      "Bash(solana account:*)",
      "Bash(solana program dump:*)",
      "Bash(solana program show:*)",
      "Bash(solana logs:*)",
      "Bash(solana confirm:*)",
      "Bash(solana transaction-history:*)",
      "Bash(solana block:*)",
      "Bash(solana block-time:*)",
      "Bash(solana epoch-info:*)",
      "Bash(solana slot:*)",
      "Bash(solana rent:*)",
      "Bash(solana airdrop:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm -F:*)",
      "Bash(pnpm fixtures:dump)",
      "Bash(pnpm --version)",
      "Bash(corepack:*)",
      "Bash(node --version)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(jq:*)",
      "Bash(sha256sum:*)",
      "Bash(shasum:*)",
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)"
    ],
    "ask": [
      "Bash(solana config set:*)",
      "Bash(solana-keygen:*)",
      "Bash(solana transfer:*)",
      "Bash(solana program deploy:*)",
      "Bash(solana program write-buffer:*)",
      "Bash(solana program set-upgrade-authority:*)",
      "Bash(solana program upgrade:*)",
      "Bash(solana program close:*)",
      "Bash(solana-verify:*)",
      "Bash(anchor deploy:*)",
      "Bash(anchor upgrade:*)",
      "Bash(anchor migrate:*)",
      "Bash(anchor verify:*)",
      "Bash(npx tsx scripts/proof/:*)",
      "Bash(npx tsx scripts/public-launch/:*)",
      "Bash(pnpm proof:*)",
      "Bash(pnpm public-launch:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Write(./.keys/**)",
      "Edit(./.keys/**)"
    ],
    "deny": [
      "Read(./.keys/mainnet/**)",
      "Read(./.keys/**/*mainnet*)",
      "Read(./**/*mainnet*.json)",
      "Read(~/.config/solana/**)",
      "Read(./**/id.json)",
      "Read(./**/*keypair*.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Bash(cat ./.keys/mainnet/**)",
      "Bash(cat ~/.config/solana/**)",
      "Bash(solana program deploy:*-u m*)",
      "Bash(solana program deploy:*--url m*)",
      "Bash(solana program deploy:*mainnet*)",
      "Bash(solana program write-buffer:*mainnet*)",
      "Bash(solana program set-upgrade-authority:*mainnet*)",
      "Bash(solana transfer:*mainnet*)",
      "Bash(solana transfer:*-u m*)",
      "Bash(anchor deploy:*mainnet*)",
      "Bash(anchor upgrade:*mainnet*)",
      "Bash(solana config set:*mainnet*)",
      "Bash(solana config set:*-um*)"
    ]
  },
  "env": {
    "NETWORK": "devnet",
    "RUST_BACKTRACE": "1"
  }
}
