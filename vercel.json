{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -F app build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/launch/:mint",
      "destination": "/index.html"
    }
  ]
}
