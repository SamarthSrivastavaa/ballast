# Keys — never committed. Mainnet keys never touch the repo at all (§17).
.keys/
*.pem
id.json
*keypair*.json

# Secrets
.env
.env.*
!.env.example

# Rust / Anchor
target/
**/target/
.anchor/
test-ledger/

# Fixtures: dumped Meteora programs and cloned accounts are large and reproducible.
# Only their hashes are committed, in evidence/fixtures/ (§17).
fixtures/*
!fixtures/.gitkeep
!fixtures/README.md

# Node
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# WASM build output (regenerated by wasm-pack)
pkg/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini

# Logs — real evidence belongs in evidence/, not here
*.log
npm-debug.log*
yarn-error.log*

# NOTE: evidence/ is deliberately NOT ignored. It is the judging record.

# proptest regression seeds: failure_persistence is off (proptest cannot locate the source
# directory from an integration-test target). Counterexamples that matter are pinned in named
# tests instead -- see ceiling_step_can_lower_f.
*.proptest-regressions
